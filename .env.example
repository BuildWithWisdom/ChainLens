# ---------- Frontend (Vite exposes only VITE_* vars to the browser) ----------
# Supabase Project URL, format: https://<project-ref>.supabase.co
# Find it via: Dashboard -> Connect button (top bar) -> React, or Settings -> API
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
# Supabase PUBLISHABLE key (sb_publishable_...) - safe for the browser, read-only via RLS
# Find it via: Dashboard -> Settings -> API Keys -> Publishable key
VITE_SUPABASE_KEY="sb_publishable_..."

# Solana RPC endpoint used by the backend indexer (mainnet).
# Public endpoint is rate-limited; for heavy use set a dedicated key
# (Helius, QuickNode, Ankr, ...) here instead.
VITE_API_URL="https://api.mainnet-beta.solana.com/"

# ---------- Backend only (never prefixed with VITE_, never shipped to browser) ----------
# Supabase SECRET key (sb_secret_...) - bypasses RLS, used by the indexer for writes
# Find it via: Dashboard -> Settings -> API Keys -> Secret keys (keep secret!)
SUPABASE_SECRET_KEY="sb_secret_..."

# How many txs to store per sampled block (mainnet blocks are large).
TXS_PER_BLOCK="10"

# How many days of raw transactions to keep. Older rows are deleted daily.
# Must cover the longest leaderboard filter in the UI (24H).
TX_RETENTION_DAYS="3"
